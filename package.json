{
  "name": "gems-match-3",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Gems — a clean, modern browser match-3 game. React + Vite + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
